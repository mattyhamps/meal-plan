{
  "name": "Meal Plan",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postStartCommand": "bash scripts/start.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Meal Plan", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-spring-boot"]
    },
    "codespaces": {
      "openFiles": ["README.md", "server/src/main/java/com/hampel/mealplan/planner/Rules.java"]
    }
  }
}
